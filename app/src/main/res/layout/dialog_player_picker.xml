<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="24dp" android:background="@drawable/dialog_bg">
    <TextView android:id="@+id/pickerTitle" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="23sp" android:fontFamily="sans-serif-medium" android:textColor="@color/text_white"/>
    <TextView android:id="@+id/pickerSubtitle" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:textSize="13sp" android:maxLines="2" android:ellipsize="end" android:textColor="@color/text_dim"/>
    <androidx.recyclerview.widget.RecyclerView android:id="@+id/playerOptions" android:layout_width="match_parent" android:layout_height="200dp" android:layout_marginTop="18dp" android:padding="4dp" android:clipToPadding="false" android:overScrollMode="never"/>
    <CheckBox android:id="@+id/rememberPlayer" android:layout_width="match_parent" android:layout_height="48dp" android:layout_marginTop="12dp" android:text="@string/remember_player" android:textSize="14sp" android:textColor="@color/text_white" android:buttonTint="#D1D9E5" android:background="@drawable/focus_tile" android:padding="8dp"/>
    <Button android:id="@+id/toggleWatched" style="@style/ActionButton"
        android:layout_width="match_parent" android:layout_height="44dp"
        android:layout_marginTop="8dp" android:visibility="gone"/>
</LinearLayout>
