<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@drawable/screen_bg" android:orientation="vertical" android:paddingStart="48dp" android:paddingEnd="48dp" android:paddingTop="28dp" android:paddingBottom="20dp">
    <LinearLayout android:layout_width="match_parent" android:layout_height="64dp" android:orientation="horizontal" android:gravity="center_vertical">
        <ImageButton android:id="@+id/btnUp" android:layout_width="42dp" android:layout_height="42dp" android:layout_marginEnd="18dp" android:src="@drawable/ic_up" app:tint="@color/text_white" android:background="@drawable/focus_tile" android:contentDescription="@string/back" android:padding="11dp"/>
        <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:orientation="vertical">
            <TextView android:id="@+id/tvPath" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="@color/text_dim" android:textSize="12sp" android:singleLine="true" android:ellipsize="middle"/>
            <TextView android:id="@+id/folderTitle" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="5dp" android:textSize="28sp" android:fontFamily="sans-serif-medium" android:textColor="@color/text_white" android:singleLine="true" android:ellipsize="end" android:includeFontPadding="false"/>
        </LinearLayout>
        <TextView android:id="@+id/folderCount" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="24dp" android:textSize="12sp" android:textColor="@color/text_dim"/>
    </LinearLayout>
    <View android:layout_width="match_parent" android:layout_height="1dp" android:layout_marginTop="16dp" android:layout_marginBottom="10dp" android:background="@color/border"/>
    <FrameLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1">
        <androidx.recyclerview.widget.RecyclerView android:id="@+id/browseList" android:layout_width="match_parent" android:layout_height="match_parent" android:padding="4dp" android:clipToPadding="false" android:overScrollMode="never" android:scrollbars="none"/>
        <TextView android:id="@+id/emptyBrowse" android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center" android:padding="32dp" android:background="@drawable/focus_tile" android:text="@string/empty_folder" android:textColor="@color/text_dim" android:textSize="16sp" android:visibility="gone"/>
    </FrameLayout>
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:text="@string/browser_remote_hint" android:textSize="11sp" android:textColor="@color/text_mid"/>
</LinearLayout>