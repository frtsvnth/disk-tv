<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="280dp" android:layout_height="@dimen/home_server_card" android:layout_marginEnd="14dp" android:focusable="true" android:clickable="true" android:orientation="vertical" android:paddingStart="18dp" android:paddingEnd="18dp" android:paddingTop="12dp" android:paddingBottom="11dp" android:background="@drawable/card_bg">
    <ImageView android:id="@+id/serverIcon" android:layout_width="24dp" android:layout_height="24dp"
        app:tint="@color/accent_cyan" android:src="@drawable/ic_server" android:contentDescription="@null"/>
    <TextView android:id="@+id/serverName" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="5dp" android:textColor="@color/text_white" android:textSize="22sp" android:fontFamily="sans-serif-medium" android:includeFontPadding="false" android:singleLine="true" android:ellipsize="end"/>
    <TextView android:id="@+id/serverAddress" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="3dp" android:textColor="@color/text_dim" android:textSize="12sp" android:includeFontPadding="false"/>
    <Space android:layout_width="1dp" android:layout_height="0dp" android:layout_weight="1"/>
    <LinearLayout android:layout_width="match_parent" android:layout_height="17dp" android:orientation="horizontal" android:gravity="center_vertical">
        <TextView android:id="@+id/serverHint" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="@string/open" android:textSize="13sp" android:fontFamily="sans-serif-medium" android:textColor="@color/accent_cyan"/>
        <ImageView android:layout_width="18dp" android:layout_height="18dp" android:src="@drawable/ic_chevron" android:contentDescription="@null"/>
    </LinearLayout>
</LinearLayout>