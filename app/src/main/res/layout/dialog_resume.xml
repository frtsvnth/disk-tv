<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="28dp" android:background="@drawable/dialog_bg">
    <TextView android:id="@+id/dialogTitle" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/resume_question" android:textColor="@color/text_white" android:textSize="24sp" android:fontFamily="sans-serif-medium"/>
    <TextView android:id="@+id/dialogBody" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="14dp" android:textColor="@color/text_dim" android:textSize="15sp" android:maxLines="2" android:ellipsize="end"/>
    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="24dp" android:text="@string/stopped_at" android:textSize="12sp" android:textColor="@color/text_dim"/>
    <TextView android:id="@+id/dialogPosition" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="5dp" android:textColor="@color/text_white" android:textSize="30sp" android:fontFamily="sans-serif-medium" android:includeFontPadding="false"/>
    <ProgressBar android:id="@+id/dialogProgress" style="?android:attr/progressBarStyleHorizontal" android:layout_width="match_parent" android:layout_height="3dp" android:layout_marginTop="14dp" android:max="1000" android:progressTint="#D1D9E5" android:progressBackgroundTint="#39424F"/>
    <LinearLayout android:layout_width="match_parent" android:layout_height="48dp" android:layout_marginTop="28dp" android:orientation="horizontal">
        <Button android:id="@+id/btnResume" style="@style/PrimaryAction" android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent" android:layout_marginEnd="12dp" android:text="@string/continue_action"/>
        <Button android:id="@+id/btnStartOver" style="@style/ActionButton" android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent" android:text="@string/start_over"/>
    </LinearLayout>
</LinearLayout>