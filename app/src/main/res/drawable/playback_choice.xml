<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape><solid android:color="@color/focus_glow"/><corners android:radius="8dp"/></shape>
    </item>
    <item android:state_activated="true">
        <shape><solid android:color="#244878"/><stroke android:width="1dp" android:color="#639BE8"/><corners android:radius="8dp"/></shape>
    </item>
    <item>
        <shape><solid android:color="#16243B"/><corners android:radius="8dp"/></shape>
    </item>
</selector>
