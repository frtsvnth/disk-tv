<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape><solid android:color="#E1EAF9"/><corners android:radius="8dp"/></shape>
    </item>
    <item android:state_activated="true">
        <shape><solid android:color="#244878"/><stroke android:width="1dp" android:color="#639BE8"/><corners android:radius="8dp"/></shape>
    </item>
    <item>
        <shape><solid android:color="#232B36"/><corners android:radius="8dp"/></shape>
    </item>
</selector>
